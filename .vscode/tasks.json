{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build Cinema",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-I${workspaceFolder}",
                "${workspaceFolder}/AccountManager/AccountManager.cpp",
                "${workspaceFolder}/Booking/Booking.cpp",
                "${workspaceFolder}/Booking/BookingManager.cpp",
                "${workspaceFolder}/Customer/Customer.cpp",
                "${workspaceFolder}/Movie/Movie.cpp",
                "${workspaceFolder}/Movie/MovieManager.cpp",
                "${workspaceFolder}/Roles/Manager.cpp",
                "${workspaceFolder}/Room/CinemaRoom.cpp",
                "${workspaceFolder}/Room/CinemaRoomManager.cpp",
                "${workspaceFolder}/Room/Seat.cpp",
                "${workspaceFolder}/Showtime/Showtime.cpp",
                "${workspaceFolder}/Showtime/ShowtimeManager.cpp",
                "${workspaceFolder}/Staff/Staff.cpp",
                "${workspaceFolder}/Ticket/StandardTicket.cpp",
                "${workspaceFolder}/Ticket/Ticket.cpp",
                "${workspaceFolder}/Ticket/VIPTicket.cpp",
                "${workspaceFolder}/User/User.cpp",
                "${workspaceFolder}/Core/Menu/Menu.cpp",
                "${workspaceFolder}/Core/Menu/MenuAuth.cpp",
                "${workspaceFolder}/Core/Menu/MenuCustomer.cpp",
                "${workspaceFolder}/Core/Menu/MenuStaff.cpp",
                "${workspaceFolder}/Core/Menu/MenuManager.cpp",
                "${workspaceFolder}/Core/Menu/MenuMovie.cpp",
                "${workspaceFolder}/Core/Menu/MenuShowtime.cpp",
                "${workspaceFolder}/Core/Menu/MenuRoom.cpp",
                "${workspaceFolder}/Core/Menu/MenuBooking.cpp",
                "${workspaceFolder}/Core/Menu/MenuStatistics.cpp",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/Main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all C++ source files of Cinema OOP project."
        }
    ]
}